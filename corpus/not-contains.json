{
  "assertion": "not-contains",
  "cases": [
    {
      "id": "not-contains/absent-element-passes",
      "args": [
        {
          "type": "list",
          "of": "int",
          "value": [
            1,
            2
          ]
        },
        {
          "type": "int",
          "value": 9
        }
      ],
      "expect": "pass"
    },
    {
      "id": "not-contains/present-element-fails",
      "args": [
        {
          "type": "list",
          "of": "int",
          "value": [
            1,
            2
          ]
        },
        {
          "type": "int",
          "value": 1
        }
      ],
      "expect": "fail",
      "detail": {
        "haystack": {
          "type": "list",
          "of": "int",
          "value": [
            1,
            2
          ]
        },
        "needle": {
          "type": "int",
          "value": 1
        }
      }
    },
    {
      "id": "not-contains/present-substring-fails",
      "args": [
        {
          "type": "string",
          "value": "hello"
        },
        {
          "type": "string",
          "value": "ell"
        }
      ],
      "expect": "fail",
      "detail": {
        "haystack": {
          "type": "string",
          "value": "hello"
        },
        "needle": {
          "type": "string",
          "value": "ell"
        }
      }
    },
    {
      "id": "not-contains/a-nan-is-absent",
      "args": [
        {
          "type": "list",
          "items": [
            {
              "type": "float",
              "value": "NaN"
            }
          ]
        },
        {
          "type": "float",
          "value": "NaN"
        }
      ],
      "expect": "pass"
    },
    {
      "id": "not-contains/a-nan-is-present-under-equate-nans",
      "args": [
        {
          "type": "list",
          "items": [
            {
              "type": "float",
              "value": "NaN"
            }
          ]
        },
        {
          "type": "float",
          "value": "NaN"
        }
      ],
      "options": [
        "equate-nans"
      ],
      "expect": "fail"
    }
  ]
}
